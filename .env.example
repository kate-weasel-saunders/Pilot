# Copy to .env.local and fill in. These two values are PUBLIC by design:
# they ship in the browser bundle. Security comes from Row Level Security,
# not from hiding them. NEVER put a service_role / secret key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# The Anthropic key is NOT a VITE_ variable and never goes in the frontend.
# It is set as a Supabase Edge Function secret (later phase):
#   npx supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
